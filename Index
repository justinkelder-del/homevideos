<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>My YouTube Links</title>
  <meta name="description" content="A simple video hub with YouTube links." />
  <style>
    :root { --max: 1100px; --radius: 14px; }
    * { box-sizing: border-box; }
    body { margin:0; font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; background:#0b0d12; color:#eef2ff; }
    header { padding: 28px 18px 10px; }
    .wrap { max-width: var(--max); margin: 0 auto; }
    h1 { margin:0 0 8px; font-size: 28px; }
    p { margin:0; opacity:.8; }
    .bar { display:flex; gap:12px; align-items:center; margin:16px 0 18px; }
    input {
      width:100%; padding:12px 14px; border-radius: 12px; border: 1px solid #2a3242;
      background:#0f1420; color:#eef2ff; outline:none;
    }
    input::placeholder { color:#98a2b3; }
    .player {
      border:1px solid #2a3242; border-radius: var(--radius); overflow:hidden; background:#0f1420;
      box-shadow: 0 10px 30px rgba(0,0,0,.35);
    }
    .player iframe { width:100%; aspect-ratio: 16/9; border:0; display:block; }
    .grid { display:grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap:14px; margin:18px 0 40px; }
    @media (max-width: 900px){ .grid{ grid-template-columns: repeat(2, 1fr);} }
    @media (max-width: 560px){ .grid{ grid-template-columns: 1fr;} }
    .card {
      border:1px solid #2a3242; border-radius: var(--radius); overflow:hidden; background:#0f1420; cursor:pointer;
      transition: transform .12s ease, border-color .12s ease;
    }
    .card:hover { transform: translateY(-2px); border-color:#4c5c78; }
    .thumb { width:100%; aspect-ratio: 16/9; object-fit: cover; display:block; }
    .meta { padding: 12px 12px 14px; }
    .title { font-weight: 650; font-size: 14px; line-height: 1.25; margin:0 0 6px; }
    .note { font-size: 12px; opacity:.75; margin:0; }
    .row {
      display:flex; gap:10px; align-items:center; justify-content:space-between; margin-top:10px;
      flex-wrap: wrap;
    }
    .btn {
      appearance:none; border:1px solid #2a3242; background:#0f1420; color:#eef2ff;
      padding:10px 12px; border-radius: 12px; cursor:pointer; text-decoration:none;
    }
    .btn:hover { border-color:#4c5c78; }
    footer { padding: 22px 18px; border-top: 1px solid #1f2633; opacity:.75; }
    code { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; }
  </style>
</head>

<body>
  <header>
    <div class="wrap">
      <h1>My YouTube Links</h1>
      <p>Click a video to play it. Use search to filter.</p>

      <div class="bar">
        <input id="search" type="search" placeholder="Search videos…" />
      </div>

      <div class="player" id="playerWrap" aria-label="Video player">
        <iframe
          id="player"
          src="https://www.youtube.com/embed/xmB4ypSYQ9M"
          title="YouTube video player"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>

      <div class="row">
        <span id="nowPlaying" style="opacity:.85; font-size: 13px;"></span>
        <a class="btn" id="openOnYouTube" href="https://www.youtube.com/watch?v=xmB4ypSYQ9M" target="_blank" rel="noopener noreferrer">
          Open on YouTube
        </a>
      </div>
    </div>
  </header>

  <main class="wrap">
    <div class="grid" id="grid"></div>
  </main>

  <footer>
    <div class="wrap">
      Add more videos by editing the <code>videos</code> list in <code>index.html</code>.
    </div>
  </footer>

  <script>
    // ✅ Your videos live here. Add more by copying the object and changing id/title/note.
    const videos = [
      {
        id: "xmB4ypSYQ9M",
        title: "My First Video",
        note: "Click to watch"
      }
    ];

    const grid = document.getElementById("grid");
    const player = document.getElementById("player");
    const search = document.getElementById("search");
    const nowPlaying = document.getElementById("nowPlaying");
    const openOnYouTube = document.getElementById("openOnYouTube");

    function thumbUrl(id) {
      return `https://img.youtube.com/vi/${id}/hqdefault.jpg`;
    }

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, s => ({
        "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
      }[s]));
    }

    function setPlayer(video) {
      player.src = `https://www.youtube.com/embed/${video.id}`;
      nowPlaying.textContent = `Now playing: ${video.title}`;
      openOnYouTube.href = `https://www.youtube.com/watch?v=${video.id}`;
    }

    function render(list) {
      grid.innerHTML = "";
      list.forEach(v => {
        const card = document.createElement("div");
        card.className = "card";
        card.tabIndex = 0;
        card.setAttribute("role", "button");
        card.setAttribute("aria-label", `Play ${v.title}`);

        card.innerHTML = `
          <img class="thumb" src="${thumbUrl(v.id)}" alt="Thumbnail for ${escapeHtml(v.title)}">
          <div class="meta">
            <p class="title">${escapeHtml(v.title)}</p>
            <p class="note">${escapeHtml(v.note || "")}</p>
          </div>
        `;

        const play = () => {
          setPlayer(v);
          document.getElementById("playerWrap").scrollIntoView({ behavior: "smooth", block: "start" });
        };

        card.addEventListener("click", play);
        card.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); play(); }
        });

        grid.appendChild(card);
      });
    }

    search.addEventListener("input", () => {
      const q = search.value.trim().toLowerCase();
      if (!q) return render(videos);
      render(
        videos.filter(v =>
          (v.title || "").toLowerCase().includes(q) ||
          (v.note || "").toLowerCase().includes(q) ||
          (v.id || "").toLowerCase().includes(q)
        )
      );
    });

    // Init
    render(videos);
    setPlayer(videos[0]);
  </script>
</body>
</html>
